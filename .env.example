# =====================================================================
#  NoxiasProspect — environment variables (template)
#  Copy this file to .env and fill in real values. NEVER commit .env.
# =====================================================================

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database / cache ---
DATABASE_URL=postgresql+asyncpg://noxias:noxias@localhost:5432/noxiasprospect
REDIS_URL=redis://localhost:6379/0

# --- Auth0 (Phase 2) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# --- Bright Data scraping ---
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_GMAPS_DATASET_ID=gd_m8ebnr0q2qlklc02fz
BRIGHTDATA_UNLOCKER_ZONE=sdk_unlocker

# --- Enrichment ---
PAPPERS_USE_SCRAPING=true
DROPCONTACT_API_KEY=          # optional, V2

# --- Pipedrive ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=

# --- Observability ---
SENTRY_DSN=

# --- Concurrency ---
ENRICHMENT_MAX_CONCURRENCY=5
BRIGHTDATA_POLL_INTERVAL_SECONDS=30
BRIGHTDATA_POLL_TIMEOUT_SECONDS=600

# =====================================================================
#  Frontend (Next.js)
# =====================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
